{
  "version": 1,
  "rings": [ "entities", "use-cases", "adapters", "frameworks" ],
  "frameworks": [ "react", "react-router", "react-dom", "@react-router/node", "@react-router/serve", "vite" ],
  "rules": [
    { "match": "packages/domain/src/**/*-use-case.ts", "ring": "use-cases", "kind": "use-case", "actors": [] },
    { "match": "packages/domain/src/**/*-reader.ts", "ring": "entities", "kind": "port", "actors": [] },
    { "match": "packages/domain/src/**/*-incidents.ts", "ring": "entities", "kind": "port", "actors": [] },
    { "match": "packages/domain/src/shared/**", "ring": "entities", "kind": "port", "actors": [] },
    { "match": "packages/domain/src/*/index.ts", "ring": "entities", "kind": "barrel", "actors": [] },
    { "match": "packages/domain/src/**", "ring": "entities", "kind": "entity", "actors": [] },
    { "match": "packages/db/src/**", "ring": "adapters", "kind": "adapter", "actors": [] },
    { "match": "packages/config/src/**", "ring": "adapters", "kind": "config", "actors": [] },
    { "match": "packages/content/src/**", "ring": "adapters", "kind": "boundary-data", "actors": [] },
    { "match": "packages/infrastructure/src/**/create-*.server.ts", "ring": "adapters", "kind": "composition-root", "actors": [] },
    { "match": "packages/infrastructure/src/**", "ring": "adapters", "kind": "adapter", "actors": [] },
    { "match": "packages/ui/src/**", "ring": "adapters", "kind": "ui", "actors": [] },
    { "match": "packages/test-support/src/**", "ring": "adapters", "kind": "test", "actors": [] },
    { "match": "apps/platform/src/features/*/data/**", "ring": "adapters", "kind": "gateway", "actors": [] },
    { "match": "apps/platform/src/features/*/api/**", "ring": "adapters", "kind": "controller", "actors": [] },
    { "match": "apps/platform/src/features/*/email/**", "ring": "adapters", "kind": "adapter", "actors": [] },
    { "match": "apps/platform/src/features/*/server/*-composition.server.ts", "ring": "frameworks", "kind": "composition-root", "actors": [] },
    { "match": "apps/platform/src/features/*/server/**", "ring": "adapters", "kind": "adapter", "actors": [] },
    { "match": "apps/platform/src/features/*/public/**", "ring": "use-cases", "kind": "boundary-data", "actors": [] },
    { "match": "apps/platform/src/features/*/ui/shared/**", "ring": "adapters", "kind": "presenter", "actors": [] },
    { "match": "apps/platform/src/features/*/ui/public/**", "ring": "adapters", "kind": "presenter", "actors": [] },
    { "match": "apps/platform/src/features/*/ui/**", "ring": "adapters", "kind": "ui", "actors": [] },
    { "match": "apps/platform/src/features/*/routes.ts", "ring": "frameworks", "kind": "entry-point", "actors": [] },
    { "match": "apps/platform/src/surfaces/*/api/**", "ring": "frameworks", "kind": "controller", "actors": [] },
    { "match": "apps/platform/src/surfaces/*/routes.ts", "ring": "frameworks", "kind": "entry-point", "actors": [] },
    { "match": "apps/platform/src/surfaces/**", "ring": "frameworks", "kind": "ui", "actors": [] },
    { "match": "apps/platform/src/server/container.server.ts", "ring": "frameworks", "kind": "composition-root", "actors": [] },
    { "match": "apps/platform/src/server/api/**", "ring": "adapters", "kind": "controller", "actors": [] },
    { "match": "apps/platform/src/server/**", "ring": "frameworks", "kind": "adapter", "actors": [] },
    { "match": "apps/platform/src/**", "ring": "frameworks", "kind": "entry-point", "actors": [] }
  ],
  "kinds": [ "entity", "use-case", "port", "boundary-data", "controller", "presenter", "gateway", "adapter", "composition-root", "entry-point", "test", "config", "ui", "mixed", "barrel" ]
}
