{
  "name": "@eli-coach-platform/platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env ./node_modules/@react-router/dev/bin.js dev --host 0.0.0.0 --port 3000",
    "build": "react-router build && node ./scripts/verify-prerendered-terms.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "start": "react-router-serve ./build/server/index.js",
    "start:local": "set -a; . ../../.env; set +a; react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@eli-coach-platform/config": "workspace:*",
    "@eli-coach-platform/content": "workspace:*",
    "@eli-coach-platform/contracts": "workspace:*",
    "@eli-coach-platform/db": "workspace:*",
    "@eli-coach-platform/domain": "workspace:*",
    "@eli-coach-platform/infrastructure": "workspace:*",
    "@eli-coach-platform/ui": "workspace:*",
    "@hookform/resolvers": "catalog:",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "@tanstack/react-query": "catalog:",
    "archiver": "catalog:",
    "canvas-confetti": "1.9.4",
    "drizzle-orm": "catalog:",
    "isbot": "catalog:",
    "lucide-react": "1.11.0",
    "motion": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-router": "catalog:",
    "resend": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/pg": "catalog:",
    "@types/archiver": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
