{
  "version": 1,
  "rings": [ "entities", "use-cases", "adapters", "frameworks" ],
  "frameworks": [ "react", "react-router", "react-dom", "@react-router/node", "@react-router/serve", "vite" ],
  "rules": [
    { "match": "apps/platform/src/bounded-contexts/*/*/domain/**/*-use-case.ts", "ring": "use-cases", "kind": "use-case", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/domain/**/*-incidents.ts", "ring": "entities", "kind": "port", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/domain/*/index.ts", "ring": "entities", "kind": "barrel", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/domain/**", "ring": "entities", "kind": "entity", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/adapters/inbound/http/**", "ring": "adapters", "kind": "controller", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/adapters/inbound/facades/**", "ring": "adapters", "kind": "controller", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/adapters/outbound/persistence/**", "ring": "adapters", "kind": "gateway", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/adapters/outbound/email/**", "ring": "adapters", "kind": "adapter", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/adapters/outbound/logging/**", "ring": "adapters", "kind": "adapter", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/adapters/outbound/*/**", "ring": "adapters", "kind": "gateway", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/public/**", "ring": "use-cases", "kind": "boundary-data", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/ui/shared/**", "ring": "adapters", "kind": "presenter", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/ui/**", "ring": "adapters", "kind": "ui", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/composition.server.ts", "ring": "frameworks", "kind": "composition-root", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/config.server.ts", "ring": "frameworks", "kind": "config", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/*/routes.ts", "ring": "frameworks", "kind": "entry-point", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/public/**", "ring": "use-cases", "kind": "boundary-data", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/composition.server.ts", "ring": "frameworks", "kind": "composition-root", "actors": [] },
    { "match": "apps/platform/src/bounded-contexts/*/routes.ts", "ring": "frameworks", "kind": "entry-point", "actors": [] },
    { "match": "apps/platform/src/shared/design-system/**", "ring": "adapters", "kind": "ui", "actors": [] },
    { "match": "apps/platform/src/shared/**", "ring": "adapters", "kind": "adapter", "actors": [] },
    { "match": "apps/platform/src/composition-root/container.server.ts", "ring": "frameworks", "kind": "composition-root", "actors": [] },
    { "match": "apps/platform/src/composition-root/api/**", "ring": "adapters", "kind": "controller", "actors": [] },
    { "match": "apps/platform/src/composition-root/**", "ring": "frameworks", "kind": "adapter", "actors": [] },
    { "match": "apps/platform/src/surfaces/*/api/**", "ring": "frameworks", "kind": "controller", "actors": [] },
    { "match": "apps/platform/src/surfaces/*/routes.ts", "ring": "frameworks", "kind": "entry-point", "actors": [] },
    { "match": "apps/platform/src/surfaces/**", "ring": "frameworks", "kind": "ui", "actors": [] },
    { "match": "apps/platform/src/**", "ring": "frameworks", "kind": "entry-point", "actors": [] }
  ],
  "kinds": [ "entity", "use-case", "port", "boundary-data", "controller", "presenter", "gateway", "adapter", "composition-root", "entry-point", "test", "config", "ui", "mixed", "barrel" ]
}
