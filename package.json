{
  "name": "eli-coach-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "catalog:",
      "brace-expansion@>=5.0.0 <5.0.11": "5.0.11",
      "compression": "1.8.2",
      "proxy-addr": "2.0.8",
      "qs": "6.16.0"
    }
  },
  "scripts": {
    "build": "pnpm --filter @eli-coach-platform/platform build",
    "check:boundaries": "depcruise --config tools/dependency-cruiser.config.cjs apps/platform/src packages/config/src packages/content/src packages/db/src packages/domain/src packages/infrastructure/src packages/test-support/src packages/ui/src && pnpm check:surfaces && node tools/domain-layout.mjs",
    "check:surfaces": "knip --no-config-hints",
    "client:media:local:prepare": "./scripts/dev/prepare_local_client_media.sh",
    "db:bootstrap:local": "./packages/db/scripts/bootstrap-local.sh",
    "db:generate": "pnpm --filter @eli-coach-platform/platform run db:generate",
    "db:migrate": "pnpm --filter @eli-coach-platform/platform run db:migrate",
    "db:setup:local": "./packages/db/scripts/setup-local.sh",
    "dev": "LOCAL_POSTGRES_PORT=${LOCAL_POSTGRES_PORT:-55437} DATABASE_PORT=${DATABASE_PORT:-${LOCAL_POSTGRES_PORT:-55437}} pnpm --filter @eli-coach-platform/platform dev",
    "dev:all": "./scripts/dev/start_local_stack.sh",
    "dev:e2e": "LOCAL_POSTGRES_PORT=${LOCAL_POSTGRES_PORT:-55437} DATABASE_PORT=${DATABASE_PORT:-${LOCAL_POSTGRES_PORT:-55437}} pnpm --filter @eli-coach-platform/platform dev:e2e",
    "dev:platform": "LOCAL_POSTGRES_PORT=${LOCAL_POSTGRES_PORT:-55437} DATABASE_PORT=${DATABASE_PORT:-${LOCAL_POSTGRES_PORT:-55437}} pnpm --filter @eli-coach-platform/platform dev",
    "docker:local:down": "docker compose -f docker-compose.local.yml down",
    "docker:local:up": "docker compose -f docker-compose.local.yml up -d",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages --ext .ts,.tsx && pnpm format:check",
    "secrets:local:prepare": "./scripts/secrets/prepare_local_secret_set.sh eli-coach-platform",
    "start:platform": "pnpm --filter @eli-coach-platform/platform start:local",
    "store:assets:local:prepare": "./scripts/dev/prepare_local_store_assets.sh",
    "terms:pdf": "pnpm --filter @eli-coach-platform/content terms:pdf",
    "test": "pnpm typecheck && vitest run",
    "test:unit": "pnpm typecheck && vitest run --project unit --project tools",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @eli-coach-platform/platform test:e2e",
    "test:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate": "pnpm validate:unit && pnpm test:integration",
    "validate:unit": "pnpm lint && pnpm check:boundaries && pnpm test:unit && STORE_ASSET_ROOT=/tmp/eli-coach-store-assets-build MANAGEMENT_API_SECRET=validation-build-management-api-secret-value pnpm build && pnpm check:deploy",
    "check:deploy": "rm -rf /tmp/eli-coach-platform-deploy-check && pnpm --filter @eli-coach-platform/platform --prod deploy /tmp/eli-coach-platform-deploy-check && node tools/check-deploy-resolves.mjs /tmp/eli-coach-platform-deploy-check"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@lhci/cli": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "globals": "catalog:",
    "happy-dom": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "msw": "catalog:",
    "prettier": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "catalog:"
  }
}
