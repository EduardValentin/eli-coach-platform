ARG NODE_IMAGE=node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e

FROM ${NODE_IMAGE} AS build

# The app resolves its @content alias to ../../packages/content/src, so the
# build stage mirrors the repository layout.
WORKDIR /repo/designs/react-reference-app

COPY designs/react-reference-app/package.json designs/react-reference-app/package-lock.json ./

RUN npm ci

COPY designs/react-reference-app ./
COPY packages/content/src /repo/packages/content/src

ARG VITE_BASE_PATH=/design-reference/

ENV VITE_BASE_PATH=$VITE_BASE_PATH

RUN npm run build

FROM ${NODE_IMAGE}

WORKDIR /app

RUN set -eux; \
  apt-get update; \
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends --only-upgrade \
    libc-bin \
    libc6 \
    libcap2 \
    libgnutls30 \
    libpcre2-8-0 \
    libsystemd0 \
    libudev1; \
  rm -rf /var/lib/apt/lists/*

RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

COPY docker/healthcheck.mjs /app/healthcheck.mjs
COPY docker/serve-static.mjs /app/serve-static.mjs
COPY --from=build /repo/designs/react-reference-app/dist /app/dist

ENV PORT=3000
ENV HEALTHCHECK_PATH=/
ENV STATIC_ROOT=/app/dist

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=12 CMD ["node", "/app/healthcheck.mjs"]

CMD ["node", "/app/serve-static.mjs"]
