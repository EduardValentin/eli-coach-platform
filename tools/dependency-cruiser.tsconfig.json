{
  "include": ["../apps/platform/src/**/*", "../packages/*/src/**/*"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["apps/platform/src/*"],
      "~integration-test-config/*": ["apps/platform/integration-test-config/*"],
      "@eli-coach-platform/config/*": ["packages/config/src/*"]
    }
  }
}
