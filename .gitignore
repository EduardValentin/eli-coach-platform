# OS / filesystem noise
.DS_Store
**/.DS_Store
Thumbs.db

# Local editor / tooling state
.idea/
.vscode/
# Shared Claude Code config is committed; personal overrides are not. The
# SessionStart hook only provisions a web container if it reaches the default
# branch, so it cannot live in ignored state.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json
*.swp
*.swo

# Environment files
.env
.env.*
!.env.example
!.env.*.example
# Committed on purpose: throwaway credentials for the ephemeral Postgres
# container the integration suites start. CI has no other source for it.
!apps/platform/test-support/.env.integration

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / frontend dependencies
node_modules/

# Frontend build and cache output
dist/
build/
.react-router/
coverage/
.lighthouseci/
.vite/
.cache/
.pnpm-store/
.turbo/

# Deployment platform output
.vercel/
.netlify/

# App build output
apps/*/build/

# Local-only scratch / notes (not checked in)
local/
.worktrees/
.superpowers/
docs/superpowers/

# Playwright MCP session scratch (page snapshots, console logs)
.playwright-mcp/
