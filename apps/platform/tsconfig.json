{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test-utils", "integration-test-config", "react-router.config.ts", "vite.config.ts", ".react-router/types/**/*"],
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"],
