{
  "name": "@eli-coach-platform/platform",
  "private": true,
  "type": "module",
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "node --env-file=../../.env ./node_modules/@react-router/dev/bin.js dev --host 0.0.0.0 --port 3000",
    "dev:e2e": "node --env-file=../../.env ./node_modules/@react-router/dev/bin.js dev --host localhost --port 3100",
    "build": "react-router build",
    "db:generate": "drizzle-kit generate --config=db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=db/drizzle.config.ts && node db/apply-seeds.ts",
    "store:cover": "tsx tooling/render-product-cover-cli.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "start": "react-router-serve ./build/server/index.js",
    "start:local": "set -a; . ../../.env; set +a; react-router-serve ./build/server/index.js",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:critical": "playwright test --config e2e/playwright.config.ts --grep @critical",
    "typecheck": "react-router typegen && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "catalog:",
    "@clerk/react-router": "catalog:",
    "@date-fns/tz": "catalog:",
    "@eli-coach-platform/config": "workspace:*",
    "@eli-coach-platform/content": "workspace:*",
    "@eli-coach-platform/db": "workspace:*",
    "@eli-coach-platform/domain": "workspace:*",
    "@eli-coach-platform/infrastructure": "workspace:*",
    "@eli-coach-platform/ui": "workspace:*",
    "@hookform/resolvers": "catalog:",
    "@napi-rs/canvas": "catalog:",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "archiver": "catalog:",
    "canvas-confetti": "1.9.4",
    "drizzle-orm": "catalog:",
    "isbot": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "pdfjs-dist": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-router": "catalog:",
    "sharp": "catalog:",
    "stripe": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@clerk/testing": "catalog:",
    "@eli-coach-platform/test-support": "workspace:*",
    "@playwright/test": "catalog:",
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/archiver": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:"
  }
}
