{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src",
    "integration-test-config",
    "tooling",
    "test-support",
    "e2e",
    "react-router.config.ts",
    "vite.config.ts",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"],
      "~integration-test-config/*": ["./integration-test-config/*"],
      "~test-support/*": ["./test-support/*"]
    },
    "rootDirs": [".", "./.react-router/types"],
    "types": ["node", "vite/client"]
  }
}
