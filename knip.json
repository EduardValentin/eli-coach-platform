{
  "workspaces": {
    ".": {
      "entry": [
        "vitest.config.mts",
        "vitest.global-setup.mts",
        "vitest.setup.mts",
        "lighthouserc.cjs",
        "tools/dependency-cruiser.config.cjs",
        "tools/*.test.mjs"
      ],
      "project": ["tools/*.{mjs,cjs}"]
    },
    "apps/platform": {
      "entry": [
        "src/root.tsx",
        "src/routes.ts",
        "src/**/routes.ts",
        "src/composition-root/api/*.ts",
        "src/composition-root/api/*/*.ts",
        "src/bounded-contexts/*/*/api/*.ts",
        "src/bounded-contexts/*/*/api/*/*.ts",
        "src/bounded-contexts/*/*/data/schema.server.ts",
        "src/bounded-contexts/*/*/ui/*/*-page.tsx",
        "src/bounded-contexts/*/*/ui/*/*/*-page.tsx",
        "src/surfaces/*/pages/**/*.tsx",
        "src/surfaces/*/shell/layout.tsx",
        "src/surfaces/*/api/*.ts",
        "db/drizzle.config.ts",
        "db/apply-seeds.ts",
        "react-router.config.ts",
        "vite.config.ts",
        "e2e/**/*.ts",
        "integration-test-config/**/*.ts",
        "tooling/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "src/**/*.css",
        "db/**/*.ts",
        "e2e/**/*.ts",
        "integration-test-config/**/*.ts",
        "test-support/**/*.ts",
        "tooling/**/*.ts"
      ],
      "ignoreDependencies": [
        "sharp",
        "@napi-rs/canvas",
        "pdfjs-dist",
        "@fastify/busboy"
      ]
    },
    "packages/*": {
      "entry": [
        "src/index.ts",
        "src/*/index.ts",
        "src/*/index.server.ts",
        "src/runtime.ts",
        "scripts/**/*.ts",
        "src/documents/pdf-pages-worker.server.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tooling/**/*.ts"],
      "includeEntryExports": true
    }
  },
  "ignore": [
    "tools/boundary-fixtures/**",
    "tools/domain-layout-fixtures/**",
    "designs/**"
  ]
}
