# E2E-only values, loaded by apps/platform/e2e on top of /.env. Copy to /.env.e2e (gitignored).
# Stripe test-mode secret key of the account the app's checkout is configured for (sk_test_… or rk_test_…).
STRIPE_SECRET_KEY=replace-me
# A random whsec_ value (e.g. whsec_ followed by `openssl rand -hex 24`): the suite's dev server verifies the webhook deliveries the journeys sign with it.
STRIPE_WEBHOOK_SIGNING_SECRET=replace-me
# The test-mode customer-portal configuration (bpc_…) the app pins its portal sessions to, so the payment-method journey lands on the same portal TEST serves; left unset, Stripe's default configuration is used.
# STRIPE_PORTAL_CONFIGURATION_ID=
