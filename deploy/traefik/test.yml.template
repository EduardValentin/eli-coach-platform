http:
  middlewares:
    eli-coach-platform-test-stack-colour:
      headers:
        customResponseHeaders:
          X-Stack-Color: __STACK_COLOR__

    eli-coach-platform-test-design-reference-strip:
      stripPrefix:
        prefixes:
          - __APP_BASE_PATH__/design-reference

  routers:
    eli-coach-platform-test-design-reference:
      entryPoints:
        - websecure
      middlewares:
        - eli-coach-platform-test-design-reference-strip
      priority: 300
      rule: Host(`__EDGE_HOSTNAME__`) && PathPrefix(`__APP_BASE_PATH__/design-reference`)
      service: eli-coach-platform-test-design-reference
      tls: {}

    eli-coach-platform-test-platform:
      entryPoints:
        - websecure
      middlewares:
        - eli-coach-platform-test-stack-colour
      priority: 1
      rule: Host(`__EDGE_HOSTNAME__`) && PathPrefix(`__APP_BASE_PATH__`)
      service: eli-coach-platform-test-platform
      tls: {}

  services:
    eli-coach-platform-test-platform:
      loadBalancer:
        servers:
          - url: http://eli-coach-platform-test-platform-__STACK_COLOR__:3000

    eli-coach-platform-test-design-reference:
      loadBalancer:
        servers:
          - url: http://eli-coach-platform-test-design-reference-__STACK_COLOR__:3000
