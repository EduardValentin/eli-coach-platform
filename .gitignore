# OS / filesystem noise
.DS_Store
**/.DS_Store
Thumbs.db

# Local editor / tooling state
.idea/
.vscode/
# Committed on purpose: the SessionStart hook that provisions Claude Code web
# sessions (docs/CLAUDE_WEB_SESSIONS.md). Everything else in .claude/ is local.
.claude/*
!.claude/settings.json
!.claude/hooks/
*.swp
*.swo

# Environment files
.env
.env.*
!.env.example
!.env.*.example
# Committed on purpose: throwaway credentials for the ephemeral Postgres
# container the integration suites start. CI has no other source for it.
!apps/platform/integration-test-config/.env.integration

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / frontend dependencies
node_modules/

# Frontend build and cache output
dist/
build/
.react-router/
coverage/
.lighthouseci/
.vite/
.cache/
.pnpm-store/
.turbo/

# Deployment platform output
.vercel/
.netlify/

# App build output
apps/*/build/

# Local-only scratch / notes (not checked in)
local/
.worktrees/
.superpowers/
docs/superpowers/

# Playwright MCP session scratch (page snapshots, console logs)
.playwright-mcp/
