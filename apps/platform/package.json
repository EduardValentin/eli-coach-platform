{
  "name": "@eli-coach-platform/platform",
  "private": true,
  "type": "module",
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "node --env-file=../../.env ./node_modules/@react-router/dev/bin.cjs dev --host 0.0.0.0 --port 3000",
    "dev:e2e": "node --env-file=../../.env ./node_modules/@react-router/dev/bin.cjs dev --host localhost --port 3100",
    "build": "react-router build",
    "db:generate": "drizzle-kit generate --config=db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=db/drizzle.config.ts && node db/apply-seeds.ts",
    "store:cover": "tsx tooling/render-product-cover-cli.ts",
    "terms:pdf": "tsx tooling/legal/generate-website-and-store-terms-pdf.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "start": "react-router-serve ./build/server/index.js",
    "start:local": "set -a; . ../../.env; set +a; react-router-serve ./build/server/index.js",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:critical": "playwright test --config e2e/playwright.config.ts --grep @critical",
    "typecheck": "react-router typegen && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "catalog:",
    "@clerk/react-router": "catalog:",
    "@date-fns/tz": "catalog:",
    "@eli-coach-platform/domain": "workspace:*",
    "@fastify/busboy": "catalog:",
    "@file-type/cfbf": "catalog:",
    "@fontsource-variable/dm-sans": "catalog:",
    "@fontsource-variable/playfair-display": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@napi-rs/canvas": "catalog:",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "@tokenizer/inflate": "catalog:",
    "archiver": "catalog:",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "file-type": "catalog:",
    "isbot": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "pdfjs-dist": "catalog:",
    "pg": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-day-picker": "catalog:",
    "react-dnd": "catalog:",
    "react-dnd-touch-backend": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-router": "catalog:",
    "resend": "catalog:",
